# Backend API URL (Empty uses Vite proxy by default)
VITE_API_BASE_URL=

# Socket.IO Server URL (Empty connects to window.location.origin)
VITE_SOCKET_URL=

# Optional: Firebase Web Push Config (FCM)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
