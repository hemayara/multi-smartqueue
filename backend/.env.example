# Application Environment
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# MongoDB Database Configuration
# Local instance or MongoDB Atlas URI:
MONGO_URI=mongodb://localhost:27017/smart_queue_db
MONGO_DB_NAME=smart_queue_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-another-super-secure-jwt-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Socket.IO Configuration
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Cloud Messaging (FCM) Configuration (Optional)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Organization Default Settings
DEFAULT_TOKEN_PREFIX=TKN
DEFAULT_ESTIMATED_SERVICE_TIME_MINUTES=5
